{
  "name": "disarm",
  "version": "0.1.0",
  "description": "Production-grade AST deobfuscator that reverses hostile anti-bot challenge scripts into readable JavaScript: unflattens control flow, inlines proxies, and harvests string banks.",
  "keywords": [
    "deobfuscator",
    "anti-bot",
    "reverse-engineering",
    "ast",
    "babel",
    "cloudflare-turnstile",
    "akamai",
    "datadome",
    "kasada",
    "threatmetrix",
    "control-flow-unflattening"
  ],
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "disarm": "src/cli.js"
  },
  "scripts": {
    "test": "node tools/verify.js && node tools/oracle.js && node tools/audit-probe.js && node test/behavior.js",
    "test:verify": "node tools/verify.js",
    "test:oracle": "node tools/oracle.js",
    "test:probe": "node tools/audit-probe.js",
    "test:behavior": "node test/behavior.js",
    "fixtures": "node tools/make-fixtures.js",
    "profile": "node tools/profile.js",
    "disarm": "node src/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.9.0"
  }
}
